<?xml version="1.0" encoding="utf-8"?>
<!--
  One day in the strip: narrow weekday letter over the date, same as the old design.

  RemoteViews.addView does honour layout_weight on the root here. The parent LinearLayout builds the
  child LayoutParams from these attributes at inflate time, so the seven cells split the width evenly
  at any size.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/day_root"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_weight="1"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/day_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/day_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:textSize="14sp" />
</LinearLayout>
