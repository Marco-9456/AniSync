<?xml version="1.0" encoding="utf-8"?>
<!--
  One day in the strip. layout_weight on the root is honoured by RemoteViews.addView, because the
  parent LinearLayout generates the child's LayoutParams from these attributes at inflate time, so
  the seven cells share the width evenly at any widget size.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/day_root"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="4dp"
    android:layout_weight="1"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/day_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/day_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
