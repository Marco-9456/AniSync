<?xml version="1.0" encoding="utf-8"?>
<!--
  Weekly Calendar. Reproduces the shipped Glance layout: 16dp header with the icon plate and a
  single filter pill, a seven day strip, then a scrolling list of episode cards.

  The header is a fixed height rather than wrap_content. Letting it wrap meant the icon, the title
  and the pill all negotiated for one line on every resize, and the title lost, which is what made
  the header look squashed as the widget got narrower.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_icon_plate_bg">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/calendar_view_week_24px"
                android:tint="@color/widget_on_primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_calendar_title"
            android:textColor="@color/widget_on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!--
      Two chips rather than one toggling pill: both states are visible at once, so the control reads
      as a choice instead of a button whose label happens to be the current value.

      On their own row because they do not fit beside an 18sp title at any width this widget is
      likely to be placed at. Sharing the line meant the title ellipsised to "Weekly Sch…" instead,
      which is a worse trade than one short row.
    -->
    <LinearLayout
        android:id="@+id/widget_filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/chip_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="@string/widget_filter_all"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chip_mine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="@string/widget_filter_mine"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <!--
          A real scrolling list. ScrollView is not permitted inside RemoteViews, so the only way to
          show more rows than fit is an adapter-backed view fed by WidgetCollection.
        -->
        <ListView
            android:id="@+id/widget_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingBottom="12dp"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:src="@drawable/calendar_view_week_24px"
                android:tint="@color/widget_on_surface_variant" />

            <TextView
                android:id="@+id/widget_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/widget_on_surface"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/widget_calendar_empty_hint"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
