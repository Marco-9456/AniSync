<?xml version="1.0" encoding="utf-8"?>
<!--
  Bottom-weighted scrim for cover-backed Watch Progress cards. The ramp is front-loaded so the
  caption band is fully dark well before the bottom edge, whatever the card's aspect.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#F2000000"
        android:centerColor="#8C000000"
        android:endColor="#00000000"
        android:centerY="0.42"
        android:type="linear" />
</shape>
