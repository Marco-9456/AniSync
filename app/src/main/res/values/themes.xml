<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Base app shell theme. DayNight so the window background resolves per night qualifier, and the
      background is the app surface (not the AppCompat default white) so the cold-start window and any
      brief pre-Compose frame match the theme instead of flashing bright in dark mode (issue #84).
    -->
    <style name="Base.Theme.AniSync" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <!--
          The bar icon appearance has to live in the theme, not only in code. core-splashscreen
          reads windowLightStatusBar and windowLightNavigationBar off the activity theme and writes
          them over the window with setSystemBarsAppearance() every time the splash hands over, so a
          theme that declared neither cleared both bits and left the icons white on a light
          background (issue #127). windowLightNavigationBar is API 27, so it is added in values-v27.
        -->
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
    </style>

    <style name="Theme.AniSync" parent="Base.Theme.AniSync" />

    <!--
      Cold-start splash theme (androidx core-splashscreen). The launcher activity boots into this; it
      draws the app surface + centered brand icon, then installSplashScreen() hands off to Theme.AniSync.
      windowSplashScreenBackground shares splash_background, so the splash is dark on a dark device.
    -->
    <style name="Theme.AniSync.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AniSync</item>
    </style>
</resources>
